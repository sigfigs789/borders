{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@game/*": ["../src/game/*"],
      "@data/*": ["../src/data/*"]
    }
  },
  "include": ["src", "../src/game", "../src/data"]
}
